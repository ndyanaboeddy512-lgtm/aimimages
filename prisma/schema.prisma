datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum Role {
  SUPERADMIN
  ADMIN
  EDITOR
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             Role              @default(ADMIN)
  status           String            @default("ACTIVE") // ACTIVE, SUSPENDED
  avatar           String?
  lastLoginAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  auditLogs        AuditLog[]
  mediaUploaded    MediaItem[]
  contentRevisions ContentRevision[]
}

model MediaItem {
  id              String            @id @default(cuid())
  url             String
  storageKey      String?
  storageBucket   String?
  storageProvider String            @default("LOCAL") // S3, R2, SUPABASE, LOCAL
  filename        String
  originalName    String
  mimeType        String
  sizeBytes       Int
  width           Int?
  height          Int?
  duration        Float?
  isVideo         Boolean           @default(false)
  posterUrl       String?
  title           String
  description     String?           @db.Text
  category        String            @default("Portfolio")
  tags            String[]
  projectId       String?
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  altText         String?
  location        String?
  captureDate     DateTime?
  featured        Boolean           @default(false)
  status          String            @default("PUBLISHED") // PUBLISHED, DRAFT, ARCHIVED
  order           Int               @default(0)

  // Soft Delete fields
  isDeleted       Boolean           @default(false)
  deletedAt       DateTime?
  deletedBy       String?

  uploadedById    String?
  uploadedBy      User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([isDeleted, status])
  @@index([category])
  @@index([projectId])
}

model Project {
  id            String            @id @default(cuid())
  title         String
  slug          String            @unique
  category      String
  description   String            @db.Text
  client        String?
  year          Int
  location      String
  coverImage    String
  videoUrl      String?
  duration      String?
  isVideo       Boolean           @default(false)
  featured      Boolean           @default(false)
  status        String            @default("PUBLISHED") // PUBLISHED, DRAFT
  order         Int               @default(0)
  gallery       String[]
  deliverables  String[]
  gearUsed      String[]

  // Soft Delete fields
  isDeleted     Boolean           @default(false)
  deletedAt     DateTime?
  deletedBy     String?

  mediaItems    MediaItem[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([isDeleted, status])
  @@index([category])
}

model Service {
  id            String            @id @default(cuid())
  title         String
  slug          String            @unique
  tagline       String
  description   String            @db.Text
  icon          String
  startingPrice String
  deliverables  String[]
  timeline      String
  order         Int               @default(0)
  status        String            @default("PUBLISHED") // PUBLISHED, DRAFT

  // Soft Delete fields
  isDeleted     Boolean           @default(false)
  deletedAt     DateTime?
  deletedBy     String?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([isDeleted, status])
}

model TeamMember {
  id          String            @id @default(cuid())
  name        String
  role        String
  bio         String            @db.Text
  image       String
  socialUrl   String?
  order       Int               @default(0)

  isDeleted   Boolean           @default(false)
  deletedAt   DateTime?
  deletedBy   String?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([isDeleted])
}

model Testimonial {
  id          String            @id @default(cuid())
  clientName  String
  roleOrEvent String
  comment     String            @db.Text
  rating      Int               @default(5)
  avatar      String?
  featured    Boolean           @default(false)
  order       Int               @default(0)
  status      String            @default("PUBLISHED")

  isDeleted   Boolean           @default(false)
  deletedAt   DateTime?
  deletedBy   String?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([isDeleted, status])
}

model SiteSetting {
  id          String            @id @default(cuid())
  key         String            @unique
  category    String            // GENERAL, HERO, BOOKINGS, CONTACT, SEO, NAVIGATION, MAPS
  value       Json
  label       String?
  description String?
  updatedById String?
  updatedAt   DateTime          @updatedAt

  revisions   SettingRevision[]

  @@index([category])
}

model SettingRevision {
  id           String           @id @default(cuid())
  settingId    String
  setting      SiteSetting      @relation(fields: [settingId], references: [id], onDelete: Cascade)
  value        Json
  version      Int
  changeReason String?
  createdById  String?
  createdAt    DateTime         @default(now())

  @@index([settingId, version])
}

model ContentRevision {
  id           String           @id @default(cuid())
  entityType   String           // Project, Service, Testimonial, MediaItem
  entityId     String
  version      Int
  snapshot     Json
  changeReason String?
  createdById  String?
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@index([entityType, entityId])
}

model AuditLog {
  id           String            @id @default(cuid())
  action       String            // CREATE, UPDATE, PUBLISH, UNPUBLISH, SOFT_DELETE, RESTORE, PERMANENT_DELETE, LOGIN, REORDER, BULK_ACTION, SETTINGS_CHANGE
  entityType   String            // MediaItem, Project, Service, SiteSetting, Testimonial, User, Auth
  entityId     String?
  entityTitle  String?
  beforeValues Json?
  afterValues  Json?
  metadata     Json?             // IP, userAgent, client details
  userId       String?
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName     String?
  userEmail    String?
  userRole     String?
  createdAt    DateTime          @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
}

model Enquiry {
  id          String            @id @default(cuid())
  name        String
  email       String
  phone       String?
  service     String
  eventDate   String?
  budgetRange String?
  message     String            @db.Text
  status      String            @default("PENDING") // PENDING, REVIEWED, BOOKED, ARCHIVED
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id           String           @id @default(cuid())
  email        String           @unique
  subscribedAt DateTime         @default(now())
}
